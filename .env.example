# Copy to .env (never commit .env). All variables are optional.
STREAMSAGE_KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# PLAINTEXT | SSL | SASL_PLAINTEXT | SASL_SSL
# PLAINTEXT is intended for local development only.
STREAMSAGE_KAFKA_SECURITY_PROTOCOL=PLAINTEXT
# Required with SASL_*: PLAIN | SCRAM-SHA-256 | SCRAM-SHA-512
STREAMSAGE_KAFKA_SASL_MECHANISM=
STREAMSAGE_KAFKA_SASL_USERNAME=
STREAMSAGE_KAFKA_SASL_PASSWORD=
# Optional CA bundle for SSL / SASL_SSL (defaults to the system trust store)
STREAMSAGE_KAFKA_SSL_CA_LOCATION=

# Seconds
STREAMSAGE_KAFKA_REQUEST_TIMEOUT=10
STREAMSAGE_KAFKA_SOCKET_TIMEOUT=10

STREAMSAGE_LOG_LEVEL=INFO

# Transport: stdio (default) or http (Streamable HTTP on http://HOST:PORT/mcp)
STREAMSAGE_TRANSPORT=stdio
STREAMSAGE_HTTP_HOST=127.0.0.1
STREAMSAGE_HTTP_PORT=8000
# Required for http. Create entries with `streamsage generate-token`; only
# hashes go here. Scopes: kafka:metadata, kafka:messages.
STREAMSAGE_HTTP_TOKENS=[]
# /metrics (Prometheus) requires a valid token unless this is true
STREAMSAGE_HTTP_METRICS_PUBLIC=false
STREAMSAGE_INCLUDE_INTERNAL_TOPICS=false

# Per-partition lag (messages) used by analyze_consumer_health.
# Starting points only: tune them to each consumer's normal throughput.
STREAMSAGE_LAG_WARNING_THRESHOLD=1000
STREAMSAGE_LAG_CRITICAL_THRESHOLD=10000

# Override the severity of finding codes (JSON). Example:
# STREAMSAGE_FINDING_SEVERITY_OVERRIDES={"NO_ACTIVE_MEMBERS": "info", "PARTITIONS_NOT_ADVANCING": "critical"}
STREAMSAGE_FINDING_SEVERITY_OVERRIDES={}

# Message inspection. Payloads are omitted unless explicitly enabled; when
# enabled, sensitive JSON fields/headers are redacted and previews truncated.
STREAMSAGE_MESSAGE_PAYLOADS_ENABLED=false
STREAMSAGE_MESSAGE_MAX_PAYLOAD_BYTES=1024
STREAMSAGE_MESSAGE_DEFAULT_LIMIT=20
STREAMSAGE_MESSAGE_MAX_LIMIT=100
# Extra names to redact, added to the defaults (comma-separated)
STREAMSAGE_MESSAGE_SENSITIVE_FIELDS=
# Key search scans only the newest messages, within these budgets
STREAMSAGE_MESSAGE_KEY_SEARCH_MAX_PER_PARTITION=1000
STREAMSAGE_MESSAGE_KEY_SEARCH_MAX_TOTAL=10000

# DLQ topics: exact names and/or glob patterns, comma-separated.
# No naming convention is assumed. Example: *.DLQ,dead-letter-*
STREAMSAGE_DLQ_TOPICS=
