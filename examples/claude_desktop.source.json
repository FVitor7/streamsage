{
  "mcpServers": {
    "streamsage-dev": {
      "command": "/absolute/path/to/uv",
      "args": [
        "run",
        "--directory",
        "/absolute/path/to/streamsage",
        "streamsage"
      ],
      "env": {
        "STREAMSAGE_KAFKA_BOOTSTRAP_SERVERS": "localhost:9092",
        "STREAMSAGE_DLQ_TOPICS": "*.DLQ",
        "STREAMSAGE_MESSAGE_PAYLOADS_ENABLED": "true"
      }
    }
  }
}
